# ===== Nhận dạng giọng nói =====
# Mặc định dùng ASR server local (thư mục ../asr-server), miễn phí, không cần key.
NEXT_PUBLIC_ASR_URL=http://localhost:8000
# Tuỳ chọn: engine Soniox cloud (trả phí ~0,12 USD/giờ)
SONIOX_API_KEY=

# ===== LLM tóm tắt: điền 1 trong các lựa chọn =====
# Miễn phí, không cần thẻ: https://aistudio.google.com/apikey (free tier có giới hạn số request/ngày)
GOOGLE_GENERATIVE_AI_API_KEY=
# Miễn phí: https://console.groq.com/keys
GROQ_API_KEY=
# Chạy offline hoàn toàn: cài Ollama, `ollama pull qwen2.5:7b`, rồi bỏ comment dòng dưới
# LLM_PROVIDER=ollama
# Trả phí
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tuỳ chọn
# LLM_MODEL=gemini-flash-latest
# SONIOX_RT_MODEL=stt-rt-v5
# SONIOX_ASYNC_MODEL=stt-async-v5

# Chỉ dùng cho asr-server/scripts/compare_providers.py (free $200 credit khi đăng ký)
DEEPGRAM_API_KEY=
