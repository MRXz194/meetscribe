# ===== Nhận dạng giọng nói =====
# ASR server (thư mục ../asr-server). Engine "Local" miễn phí, không cần key.
NEXT_PUBLIC_ASR_URL=http://localhost:8000
# Engine "Deepgram" (cloud): https://console.deepgram.com (free $200 credit khi đăng ký).
# asr-server tự đọc key này từ file .env.local, không cần khởi động lại.
DEEPGRAM_API_KEY=

# ===== LLM tóm tắt: điền 1 trong các lựa chọn =====
# Miễn phí, không cần thẻ: https://aistudio.google.com/apikey (free tier có giới hạn số request/ngày)
GOOGLE_GENERATIVE_AI_API_KEY=
# Miễn phí: https://console.groq.com/keys
GROQ_API_KEY=
# Chạy offline hoàn toàn: cài Ollama, `ollama pull qwen2.5:7b`, rồi bỏ comment dòng dưới
# LLM_PROVIDER=ollama
# Trả phí
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Tuỳ chọn
# LLM_MODEL=gemini-flash-latest
